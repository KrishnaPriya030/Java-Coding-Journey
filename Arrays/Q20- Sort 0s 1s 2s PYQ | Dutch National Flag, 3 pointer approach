import java.util.*;
class Solution{
static void sort(int [] arr){
int start=0;
int mid=0;
int end=arr.length-1;
while(mid<=end){
switch(arr[mid]){
case 0:
swap(arr,start,mid);
start++;
mid++;
break;
case 1:
mid++;
break;
case 2:
swap(arr,mid,end);
end--;
break;
}
}
for(int i=0; i<arr.length; i++){
System.out.print(arr[i]+" ");
}
}
static void swap(int [] arr,int pos1,int pos2){
int temp=arr[pos1];
arr[pos1]= arr[pos2];
arr[pos2]=temp;
}
public static void main(String[] args){
Scanner sc = new Scanner(System.in);
int n = sc.nextInt();
int[] arr = new int[n];
for(int i=0; i<n; i++){
arr[i] = sc.nextInt();
}
sort(arr);
}
}
